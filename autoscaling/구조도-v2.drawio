<mxfile host="app.diagrams.net" modified="2026-08-18T00:00:00.000Z" agent="drawio" version="24.0.0">
  <diagram name="yogurtte-architecture-v2" id="arch-v2">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 변경점 범례 -->
        <mxCell id="legend" value="&lt;b&gt;v2 (2026-08) 변경점 — 전부 실측 반영&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. WSS 직결(ws-yogurtte.com → proxy:443) 제거&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ HTTP·WSS 모두 CloudFront 단일 진입&lt;br&gt;2. 노드 인스턴스 타입 실측 표기 (micro/small/medium/nano)&lt;br&gt;3. Ingress는 별도 EC2가 아니라 edge 노드의 DaemonSet&lt;br&gt;4. chat도 RDS MySQL 사용 (프라이빗 IP 직참조)&lt;br&gt;5. content 2 replica는 podAntiAffinity로 노드 분산" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="360" height="170" as="geometry" />
        </mxCell>

        <!-- 사용자 -->
        <mxCell id="user" value="사용자" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- CloudFront -->
        <mxCell id="cf" value="&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;br&gt;yogurtte.com&lt;br&gt;&lt;font color=&quot;#994c00&quot;&gt;정적(S3) + /api/* + &lt;b&gt;wss /api/chat/ws&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacingLeft=44;align=left;" vertex="1" parent="1">
          <mxGeometry x="180" y="400" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cf-icon" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1">
          <mxGeometry x="186" y="425" width="36" height="36" as="geometry" />
