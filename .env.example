# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- Grafana Cloud ---
# Console -> your Stack -> Tempo "Send Traces" card: URL + User (numeric instance ID)
TEMPO_URL=
TEMPO_USER=
# Console -> your Stack -> Loki "Send Logs" card: URL + User
LOKI_URL=
LOKI_USER=
# Console -> your Stack -> Prometheus "Send Metrics" card: URL + User
MIMIR_URL=
MIMIR_USER=
# Console -> Security -> Access Policies -> create token with traces:read, logs:read, metrics:read
GRAFANA_TOKEN=

# --- LLM: set provider, then fill only that provider's key ---
# anthropic | openai | claude-cli
RCA_LLM_PROVIDER=claude-cli
# console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
# platform.openai.com -> API keys
OPENAI_API_KEY=
# absolute path to the `claude` binary; leave empty to resolve from PATH
CLAUDE_CLI_PATH=

# --- Notifier ---
# console | slack | discord
RCA_NOTIFIER=console
# Slack app -> Incoming Webhooks -> Add New Webhook to Workspace
SLACK_WEBHOOK_URL=
# Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=
