# .env로 복사해서 값을 채우세요. .env는 gitignore되어 있습니다 - 실제 값은 절대 커밋하지 마세요.
# 필수 섹션과, 선택한 provider/notifier 블록만 채우면 됩니다.
# "선택 튜닝" 아래는 전부 합리적인 기본값이 있습니다.

# --- Grafana Cloud (필수) ---
# 콘솔 -> 해당 Stack -> Tempo "Send Traces" 카드: URL + User(숫자 인스턴스 ID)
TEMPO_URL=
TEMPO_USER=
# 같은 Stack 화면의 Loki "Send Logs" 카드: URL + User
LOKI_URL=
LOKI_USER=
# 같은 Stack 화면의 Prometheus "Send Metrics" 카드: URL + User
MIMIR_URL=
MIMIR_USER=
# 콘솔 -> Security -> Access Policies -> traces:read, logs:read, metrics:read 스코프로 토큰 생성
GRAFANA_TOKEN=

# --- LLM: provider를 고르고, 그 provider의 블록만 채우세요 ---
# anthropic | openai | claude-cli
RCA_LLM_PROVIDER=claude-cli
# console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
# platform.openai.com -> API keys
OPENAI_API_KEY=
# `claude` 바이너리 절대경로. 비우면 PATH에서 찾습니다
CLAUDE_CLI_PATH=

# --- Notifier: 채널을 고르고, 그 채널의 블록만 채우세요 ---
# console | slack | discord
RCA_NOTIFIER=console
# Slack 앱 -> Incoming Webhooks -> Add New Webhook to Workspace
SLACK_WEBHOOK_URL=
# Discord 채널 -> 채널 편집 -> 연동 -> 웹후크 -> 새 웹후크
DISCORD_WEBHOOK_URL=

# --- 선택 튜닝 (기본값 표기) ---
#SERVER_PORT=8080
#RCA_LOG_LEVEL=INFO
#RCA_LOG_DIR=./logs
#RCA_REPORT_DIR=./reports
# 시스템 프롬프트 마크다운 파일. 없으면 클래스패스 기본 프롬프트를 씁니다
#RCA_PROMPT_PATH=./prompts/system-prompt.md

# LLM 옵션
#RCA_ANTHROPIC_MODEL=claude-opus-4-8
#RCA_ANTHROPIC_MAX_TOKENS=8192
#RCA_OPENAI_MODEL=gpt-4o
#CLAUDE_CLI_TIMEOUT_SECONDS=120

# Grafana HTTP 타임아웃
#GRAFANA_CONNECT_TIMEOUT_MS=3000
#GRAFANA_READ_TIMEOUT_MS=10000

# 수집 시간창/쿼리 (metric-queries PromQL 목록은 application.yml에서만 변경)
#RCA_WINDOW_PADDING_SECONDS=120
#RCA_APPS=content|auth|chat
#RCA_APP_LABEL=app
#RCA_LEVEL_LABEL=level
#RCA_LOG_LIMIT=1000
#RCA_METRIC_STEP=15s
#RCA_MAX_TRACE_BYTES=102400
#RCA_TOP_SPANS=30
